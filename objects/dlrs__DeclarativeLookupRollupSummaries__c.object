<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>dlrs__CalculateJobScopeSize__c</fullName>
        <defaultValue>100</defaultValue>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <label>Calculate Job Scope Size</label>
        <precision>6</precision>
        <required>true</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>dlrs__DisableDLRSGlobally__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Turns off all DLRS calculations</description>
        <inlineHelpText>Disable DLRS calculations, useful for bulk loading or other large-scale actions</inlineHelpText>
        <label>Disable DLRS Globally</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>dlrs__DisableParentDMLCheck__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Turns off the DML guard that queries the parent record before DML to filter out records that wouldn&apos;t actually change the parent&apos;s held rollup value. Should be used if you&apos;re tight on SQL queries and know that your actions will almost always cause rollup value changes.</description>
        <inlineHelpText>Disable the feature to query and compare the parent before executing DML.</inlineHelpText>
        <label>Disable Parent DML Check</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>dlrs__DisableProblemEmails__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Stop DLRS from sending emails when unexpected problems occur during calculation</description>
        <inlineHelpText>Disable calculation problem emails</inlineHelpText>
        <label>Disable Problem Emails</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>dlrs__HideManageLookupRollupSummariesInfo__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <label>Hide Manage Lookup Rollup Summaries Info</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>dlrs__ScheduledJobScopeSize__c</fullName>
        <defaultValue>100</defaultValue>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <label>Scheduled Job Scope Size</label>
        <precision>6</precision>
        <required>true</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Declarative Lookup Rollup Summaries</label>
    <visibility>Public</visibility>
</CustomObject>
